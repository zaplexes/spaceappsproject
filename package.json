{
  "name": "martian-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-cesium.mjs",
    "predev": "node scripts/prepare-cesium.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "prebuild": "node scripts/prepare-cesium.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:live": "LIVE_IMAGERY=1 playwright test tests/live-imagery.spec.ts"
  },
  "dependencies": {
    "cesium": "1.147.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "10.14.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}

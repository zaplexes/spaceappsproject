        <title>Geologic map of Jezero crater and the Nili Planum region, Mars</title>
        <geoform>vector digital data</geoform>
        <serinfo>
          <sername>SIM</sername>
          <issue>3464</issue>
        </serinfo>
        <pubinfo>
